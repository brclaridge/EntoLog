<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_specimen"
        style="@style/Widget.FieldCollect.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/new_specimen"
        app:icon="@android:drawable/ic_menu_camera" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_trap"
        style="@style/Widget.FieldCollect.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/new_trap_sample"
        app:icon="@android:drawable/ic_menu_today" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_view_records"
        style="@style/Widget.FieldCollect.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/view_records" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sync"
        style="@style/Widget.FieldCollect.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_wifi_sync" />

    <TextView
        android:id="@+id/sync_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textIsSelectable="true"
        android:visibility="gone" />

</LinearLayout>
